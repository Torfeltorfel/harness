{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh" }]
      },
      {
        "matcher": "Read|Edit|MultiEdit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-env.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [{ "type": "command", "command": "f=$(jq -r '.tool_input.file_path // empty'); [ -n \"$f\" ] && npx prettier --write --ignore-unknown \"$f\" >/dev/null 2>&1; exit 0" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "[ \"$(jq -r '.stop_hook_active')\" = true ] && exit 0; cd \"$CLAUDE_PROJECT_DIR\" && { npm run -s typecheck && npm run -s lint; } 1>&2 || exit 2" }]
      }
    ]
  }
}
